---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import hero1Image from '../../../assets/img/products/Mens_RangitataHoodie_BeechGreenAndTussock/WildBalance_Mens200_FrontHoodDown_Alpine.jpg';

const sizeRows = [
	['XS', '87.5–88 cm', '—', '—'],
	['S', '94 cm', '+6–6.5 cm', '7%'],
	['M', '100–100.5 cm', '+6–6.5 cm', '6.5–7%'],
	['L', '107–107.5 cm', '+7 cm', '7%'],
	['XL', '116–117 cm', '+9–9.5 cm', '8.5%'],
	['XXL', '126–128 cm', '+10–11 cm', '9%'],
];
---

<BaseLayout
	title="Rangitata Merino Hoodie Size Chart | Wild Balance"
	description="Draft size chart for the first Wild Balance men’s merino hoodie."
	image={hero1Image.src}
>
	<Section
		eyebrow="Size chart"
		title="Men’s merino hoodie"
		intro="These measurements are still being finalised, but this is the working chart we are using as the first release comes together."
		narrow
	>
		<div class="overflow-x-auto border border-[#2c271f]/15 bg-[#f8f3e9]">
			<table class="min-w-[680px] w-full border-collapse text-left">
				<thead class="bg-[#e4d8c7]">
					<tr class="text-xs font-semibold uppercase tracking-[0.22em] text-[#626b43]">
						<th scope="col" class="px-4 py-4">Size</th>
						<th scope="col" class="px-4 py-4">Proposed sewn chest</th>
						<th scope="col" class="px-4 py-4">Increase</th>
						<th scope="col" class="px-4 py-4">Approx. increase</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-[#2c271f]/10">
					{sizeRows.map((row, index) => (
						<tr class={index === 0 ? 'bg-[#f8f3e9]' : 'bg-[#fcfaf5]'}>
							<th scope="row" class="px-4 py-4 text-sm font-semibold text-[#2c271f]">
								{row[0]}
							</th>
							<td class="px-4 py-4 text-sm text-[#625a4d]">{row[1]}</td>
							<td class="px-4 py-4 text-sm text-[#625a4d]">{row[2]}</td>
							<td class="px-4 py-4 text-sm text-[#625a4d]">{row[3]}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<div class="mt-8 grid gap-4 md:grid-cols-2">
			<div class="border border-[#2c271f]/15 bg-[#e4d8c7] p-5">
				<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#626b43]">Fit note</p>
				<p class="mt-3 text-sm leading-6 text-[#625a4d]">
					The final cut is intended to work as a close-fitting outer or mid-layer for active use.
				</p>
			</div>
			<div class="border border-[#2c271f]/15 bg-[#e4d8c7] p-5">
				<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#626b43]">Need help</p>
				<p class="mt-3 text-sm leading-6 text-[#625a4d]">
					If you are between sizes, use the main product page link to judge whether you want a closer or looser fit.
				</p>
			</div>
		</div>
	</Section>

	<Section tone="muted" narrow>
		<div class="flex flex-wrap items-center justify-between gap-4">
			<p class="text-base leading-7 text-[#625a4d]">
				Measurements may shift slightly as the first release is finalised.
			</p>
			<a
				href="/shop/rangitata-merino-hoodie-mens-beech-green-tussock"
				class="inline-flex items-center justify-center rounded-[6px] border border-[#2c271f]/15 bg-[#efe8db] px-4 py-3 text-sm font-semibold text-[#2c271f] transition-colors hover:border-[#2c271f]/25 hover:bg-[#e9e0d1]"
			>
				Back to product
			</a>
		</div>
	</Section>
</BaseLayout>
