---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import { rangitataProducts } from '../../data/rangitataProducts';

const shopItems = [
	{
		href: '/shop/rangitata-merino-hoodie-mens-beech-green-tussock',
		product: rangitataProducts.mensBeech,
	},
	{
		href: '/shop/rangitata-merino-hoodie-mens-greywacke-black-shibori',
		product: rangitataProducts.mensGreywacke,
	},
	{
		href: '/shop/rangitata-merino-hoodie-womens-beech-green-tussock',
		product: rangitataProducts.womensBeech,
	},
	{
		href: '/shop/rangitata-merino-hoodie-womens-greywacke-black-shibori',
		product: rangitataProducts.womensGreywacke,
	},
];
---

<BaseLayout
	title="Shop | Wild Balance"
	description="The first Wild Balance release, available in men's and women's fit with two colourways."
	image={rangitataProducts.mensBeech.galleryImages[0].desktopSrc}
>
	<section class="border-b border-[#2c271f]/10 bg-[#efe8db] pb-12 pt-8 sm:pb-16 sm:pt-10 lg:py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
			<header class="max-w-3xl">
				<h1 class="text-4xl font-semibold leading-[0.95] tracking-normal text-[#2c271f] sm:text-5xl">Made for the mountains.<br /><span class="whitespace-nowrap">Made here.</span></h1>
				<div class="mt-5 space-y-4 text-base leading-7 text-[#625a4d]">
					<p>Introducing the Rangitata Merino Hoodie. The first release from Wild Balance.</p>
					<p>Made from natural merino and produced in Christchurch, the Rangitata is designed for life in the hills. Available in two colourways, with men's and women's fits.</p>
					<p>Our first production run is now open for orders until 30 November 2026.</p>
					<p class="font-semibold text-[#2c271f]">Explore the Rangitata below.</p>
				</div>
			</header>

			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{shopItems.map(({ href, product }) => (
					<a href={href} class="group block">
						<div class="space-y-3">
							<ImageFrame
								src={product.galleryImages[0].desktopSrc}
								mobileSrc={product.galleryImages[0].mobileSrc}
								desktopSrc={product.galleryImages[0].desktopSrc}
								alt={product.galleryImages[0].alt}
								aspect="square"
								objectPosition="center top"
							/>
							<div class="space-y-1.5">
								<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[#626b43]">
									{product.fitLabel === 'Men’s Fit' ? 'MEN’S MERINO' : 'WOMEN’S MERINO'}
								</p>
								<p class="text-sm leading-6 text-[#625a4d]">
									{product.colourwayLabel}
								</p>
								<p class="text-sm font-semibold uppercase tracking-[0.24em] text-[#626b43]">
									{product.priceLabel}
								</p>
								<p class="text-sm font-semibold leading-6 text-[#626b43] underline decoration-[#626b43]/40 underline-offset-4">
									View / Pre-order
								</p>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-7xl px-5 py-10 sm:px-6 lg:px-8">
		<div class="max-w-3xl space-y-4 text-base leading-7 text-[#625a4d]">
			<h2 class="text-3xl font-semibold leading-tight text-[#2c271f] sm:text-4xl">Ordering your Rangitata hoodie</h2>
			<p class="font-semibold text-[#2c271f]">First production run. Orders close 30 November 2026.</p>
			<p>Choose your preferred colour and size, then get in touch to place your order. We'll confirm the details with you and organise the deposit to get your order underway.</p>
			<p>The remaining balance is payable before your hoodie is posted.</p>
			<p class="font-semibold text-[#2c271f]">Pricing</p>
			<ul class="list-disc space-y-2 pl-5">
				<li>Standard green: NZ$195 (NZ$97.50 deposit)</li>
				<li>Hand-dyed grey: NZ$245 (NZ$122.50 deposit)</li>
			</ul>
			<p>To order, <a href="mailto:ray@wildbalance.nz" class="underline underline-offset-4">email ray@wildbalance.nz</a> or get in touch <a href="/contact" class="underline underline-offset-4">through this website</a>.</p>
			<h3 class="pt-2 text-xl font-semibold text-[#2c271f]">Production and delivery</h3>
			<p>All hoodies are made in our Christchurch workshop. We'll be putting hunting trips on hold over December to focus on getting orders made and dispatched as quickly as possible!</p>
			<p>We'll confirm shipping costs and delivery arrangements when we discuss your order.</p>
		</div>
	</section>
</BaseLayout>
