---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImageFrame from '../components/ImageFrame.astro';
import Section from '../components/Section.astro';

import bodyImage from '../assets/img/faq/HowToMeasureYourself.jpg';
import chestImage from '../assets/img/faq/HowToMeasureAnotherGarment_ChestWidth.jpg';
import sleeveImage from '../assets/img/faq/HowToMeasureAnotherGarment_SleeveUnder.jpg';
import hemImage from '../assets/img/faq/HowToMeasureAnotherGarment_BottomHem.jpg';
import backImage from '../assets/img/faq/HowToMeasureAnotherGarment_Back.jpg';

const bodyMeasurements = [
	{
		title: 'Chest / Bust',
		text: 'Measure around the widest part of your chest or bust, keeping the tape level around your body.',
	},
	{
		title: 'Waist',
		text: 'Measure around the narrowest part of your waist.',
	},
	{
		title: 'Hips',
		text: 'Stand naturally and measure around the widest part of your hips.',
	},
	{
		title: 'Height',
		text: 'Measure your full height without shoes.',
	},
];

const garmentMeasurements = [
	{
		title: 'Armpit to Armpit',
		text: 'Measure the garment laid flat from one armpit seam to the other.',
		image: chestImage,
		alt: 'A hoodie laid flat with an arrow showing the chest width from one armpit seam to the other.',
	},
	{
		title: 'Inside Sleeve Length',
		text: 'Measure from the armpit seam to the end of the cuff.',
		image: sleeveImage,
		alt: 'An arrow along the inside of a sleeve from the armpit seam to the end of the cuff.',
	},
	{
		title: 'Bottom Hem Width',
		text: 'Measure straight across the bottom hem.',
		image: hemImage,
		alt: 'An arrow across the bottom hem of a hoodie laid flat.',
	},
	{
		title: 'Back Neck to Hem',
		text: 'Measure from the centre back neck seam to the bottom hem.',
		image: backImage,
		alt: 'The back of a hoodie laid flat with an arrow from the centre back neck seam to the bottom hem.',
	},
];
---

<BaseLayout
	title="Sizing | Wild Balance"
	description="Share your body measurements and details of a garment you already like the fit of so we can help confirm your Wild Balance size."
	image={bodyImage.src}
>
	<section class="border-b border-[#2c271f]/10 bg-[#efe8db] pb-12 pt-8 sm:pb-16 sm:pt-10 lg:py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
			<PageHeader
				eyebrow="Sizing"
				title="Let's find your best fit"
				intro="Wild Balance garments are made to order. Your body measurements are the foundation, and your size in another garment gives us a useful reference."
			/>

			<div class="mt-8 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
				<div>
					<h2 class="text-2xl font-semibold text-[#2c271f]">
						1. Measure your body
					</h2>

					<p class="mt-3 text-base leading-7 text-[#625a4d]">
						These measurements are the starting point for confirming the best size.
					</p>

					<ul class="mt-6 list-disc space-y-3 pl-5 text-base leading-7 text-[#625a4d]">
						{
							bodyMeasurements.map((measurement) => (
								<li>
									<strong class="text-[#2c271f]">
										{measurement.title}:
									</strong>
									{' '}
									{measurement.text}
								</li>
							))
						}
					</ul>
				</div>

				<ImageFrame
					src={bodyImage.src}
					mobileSrc={bodyImage.src}
					desktopSrc={bodyImage.src}
					alt="Guide showing how to measure chest or bust, waist, hips and height."
					aspect="portrait"
					objectPosition="center"
				/>
			</div>
		</div>
	</section>

	<Section tone="default">
		<div class="max-w-3xl">
			<h2 class="text-2xl font-semibold text-[#2c271f]">
				2. Tell us about a garment that already fits you well
			</h2>

			<p class="mt-3 text-base leading-7 text-[#625a4d]">
				Find a similar top, hoodie or mid-layer that fits the way you like.
				Alongside your body measurements, tell us:
			</p>

			<ul class="mt-5 list-disc space-y-3 pl-5 text-base leading-7 text-[#625a4d]">
				<li>
					<strong class="text-[#2c271f]">Brand:</strong>
					the brand of the garment you like the fit of.
				</li>

				<li>
					<strong class="text-[#2c271f]">Size:</strong>
					the size shown on that garment.
				</li>
			</ul>

			<p class="mt-5 text-base leading-7 text-[#625a4d]">
				Sizing varies between brands, so this gives us a useful real-world reference
				for interpreting your measurements and understanding the fit you prefer.
			</p>

			<p class="mt-4 font-semibold leading-7 text-[#3d372d]">
				Ideally, send us your body measurements plus the brand and size of your reference garment.
			</p>
		</div>
	</Section>

	<Section tone="muted">
		<h2 class="text-2xl font-semibold text-[#2c271f]">
			3. If you don't know the brand or size
		</h2>

		<div class="mt-3 max-w-3xl">
			<p class="text-base leading-7 text-[#625a4d]">
				If you don't know the brand or size, or want to give us a more precise
				reference, lay a similar garment flat and measure it instead.
			</p>
		</div>

		<div class="mt-8 grid gap-8 md:grid-cols-2">
			{
				garmentMeasurements.map((measurement) => (
					<div>
						<h3 class="text-xl font-semibold text-[#2c271f]">
							{measurement.title}
						</h3>

						<p class="mt-2 mb-4 text-base leading-7 text-[#625a4d]">
							{measurement.text}
						</p>

						<ImageFrame
							src={measurement.image.src}
							mobileSrc={measurement.image.src}
							desktopSrc={measurement.image.src}
							alt={measurement.alt}
							aspect="square"
							objectPosition="center"
						/>
					</div>
				))
			}
		</div>
	</Section>

	<Section tone="default">
		<div class="max-w-3xl space-y-4 text-base leading-7 text-[#625a4d]">
			<h2 class="text-2xl font-semibold text-[#2c271f]">
				A note on fit
			</h2>

			<p>
				Let us know if you normally prefer your tops fitted, standard, or a little roomier.
				This helps us interpret your measurements and recommend the most suitable size.
			</p>

			<p>
				We use your body measurements, reference garment and fit preference together
				before confirming the size and cutting your made-to-order garment.
			</p>

			<p>
				Send your details or a photo of your reference garment to
				<a
					href="mailto:ray@wildbalance.nz"
					class="font-semibold text-[#2c271f] underline underline-offset-4"
				>
					ray@wildbalance.nz
				</a>,
				or
				<a
					href="/contact"
					class="font-semibold text-[#2c271f] underline underline-offset-4"
				>
					get in touch
				</a>
				if you'd like a hand.
			</p>
		</div>
	</Section>
</BaseLayout>