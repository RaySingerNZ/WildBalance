---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import hero1Image from '../assets/img/WildBalance_Hero1.jpg';
---

<BaseLayout
	title="Thanks | Wild Balance"
	description="Thanks for contacting Wild Balance."
	image={hero1Image.src}
	robots="noindex,follow"
>
	<Section
		eyebrow="Message received"
		title="Thanks - we’ve got your message."
		intro="We’ll reply to your enquiry. For pre-orders, we’ll confirm sizing, availability and bank transfer details. Your order is confirmed once the 50% deposit is paid; the remaining balance is payable before dispatch."
		narrow
	/>
</BaseLayout>
