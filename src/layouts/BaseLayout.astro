---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	robots?: string;
}

const {
	title = 'Wild Balance | Handmade New Zealand Merino',
	description = 'Handmade merino outdoor clothing from Christchurch, New Zealand.',
	image = '/WILD_BALANCE_3D.png',
	robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://wildbalance.nz').href;
const socialImage = new URL(image, Astro.site ?? 'https://wildbalance.nz').href;
const siteName = 'Wild Balance';
const siteUrl = Astro.site ?? 'https://wildbalance.nz';
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pathSegments = normalizedPath === '/' ? [] : normalizedPath.split('/').filter(Boolean);

const breadcrumbLabelMap: Record<string, string> = {
	about: 'About',
	contact: 'Contact',
	products: 'Products',
	shop: 'Shop',
	thanks: 'Thanks',
	'rangitata-merino-hoodie': 'Rangitata Merino Hoodie',
	'mens-beech-green-tussock': "Men's Beech Green / Tussock",
	'mens-greywacke-black-shibori': "Men's Greywacke / Black Shibori",
	'womens-beech-green-tussock': "Women’s Beech Green / Tussock",
	'womens-greywacke-black-shibori': "Women’s Greywacke / Black Shibori",
};

const toTitleCase = (segment: string) =>
	segment
		.split('-')
		.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
		.join(' ');

const breadcrumbItems = normalizedPath === '/'
	? []
	: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: new URL('/', siteUrl).href,
			},
			...pathSegments.map((segment, index) => {
				const href = `/${pathSegments.slice(0, index + 1).join('/')}/`;

				return {
					'@type': 'ListItem',
					position: index + 2,
					name: breadcrumbLabelMap[segment] ?? toTitleCase(segment),
					item: new URL(href, siteUrl).href,
				};
			}),
		];

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: siteName,
		url: new URL('/', siteUrl).href,
		logo: new URL('/favicon.svg', siteUrl).href,
		description,
		sameAs: ['https://www.instagram.com/wildbalance.nz/'],
		contactPoint: [
			{
				'@type': 'ContactPoint',
				contactType: 'customer service',
				email: 'ray@wildbalance.nz',
				availableLanguage: ['English'],
			},
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: siteName,
		url: new URL('/', siteUrl).href,
		description,
	},
	...(breadcrumbItems.length > 0
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'BreadcrumbList',
					itemListElement: breadcrumbItems,
				},
			]
		: []),
];
---

<!doctype html>
<html lang="en-NZ">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content={siteName} />
		<meta name="theme-color" content="#efe8db" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="min-h-screen bg-[#efe8db] text-[#2c271f]">
			<Header />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>
